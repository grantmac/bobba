{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {"api/mcp.js": {"memory":2048,"maxDuration":120,"includeFiles":"node_modules/{@sparticuz/chromium/bin,@jimp/plugin-print/dist/fonts}/**"}},
  "rewrites": [{"source":"/connect","destination":"/connect.md"}],
  "headers": [
    {
      "source": "/connect",
      "headers": [{"key":"Content-Type","value":"text/plain; charset=utf-8"},{"key":"Cache-Control","value":"no-store"}]
    },
    {
      "source": "/connect.md",
      "headers": [{"key":"Content-Type","value":"text/plain; charset=utf-8"},{"key":"Cache-Control","value":"no-store"}]
    },
    {
      "source": "/",
      "headers": [{"key": "Cache-Control", "value": "no-store"}]
    },
    {
      "source": "/(.*)",
      "headers": [{"key": "Referrer-Policy", "value": "no-referrer"}]
    }
  ]
}
