{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/version.json",
      "headers": [{"key": "Cache-Control", "value": "no-store"}]
    },
    {
      "source": "/",
      "headers": [{"key": "Cache-Control", "value": "no-store"}]
    },
    {
      "source": "/(.*)",
      "headers": [{"key": "Referrer-Policy", "value": "no-referrer"}]
    }
  ]
}
